# ==============================================================================
# Java DSA Mastery Frontend — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' or '.env.local' in the frontend directory if needed.
# ==============================================================================

# API Base URL for backend communication.
# Default: '/api/v1' (automatically proxied to http://localhost:8080/api/v1 via vite.config.ts in dev mode).
# For hosted or standalone production deployments where frontend and backend reside on different domains,
# provide the absolute URL to the Spring Boot API, for example:
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=/api/v1
