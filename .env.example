# ==============================================================================
# Java DSA Mastery — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' for local configuration.
# NEVER commit real credentials, production secrets, or private keys to source control.
# ==============================================================================

# --- Application Profile & Persistence ---
# Options: 'default' (In-Memory mode, zero dependencies) or 'postgres' (PostgreSQL persistence)
SPRING_PROFILES_ACTIVE=default
JAVADSA_PERSISTENCE_ENABLED=false

# --- PostgreSQL Database (Required only when SPRING_PROFILES_ACTIVE=postgres) ---
# Default local development port is 5433 to avoid conflicts with default PostgreSQL instances.
# When running with docker-compose, internal container URL is: jdbc:postgresql://postgres:5432/java_dsa_mastery_phase2b_test
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/java_dsa_mastery_phase2b_test
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword
POSTGRES_PASSWORD=postgrespassword

# HikariCP Pool Configuration (conservative defaults suited for free-tier databases)
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2

# --- Security & Learner Capability Tokens ---
# Secret key used for HMAC-SHA256 signature verification of anonymous learner capability tokens (X-Learner-Token).
# MUST be at least 32 characters long. In production, supply a cryptographically secure random string.
JAVADSA_SECURITY_TOKEN_SECRET=javadsa-mastery-default-secret-key-32chars-min!

# Strict session ownership check (true: verifies token signature matches session owner)
JAVADSA_STRICT_OWNERSHIP=true

# Comma-separated CORS allowed origins. Include your frontend development and production URLs.
JAVADSA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Comma-separated IP addresses of trusted reverse proxies (e.g. Nginx, Cloudflare) if running behind one.
JAVADSA_TRUSTED_PROXIES=

# --- Rate Limiting & Protection ---
JAVADSA_RATE_LIMIT_ENABLED=true
JAVADSA_GENERAL_RPM=300
JAVADSA_LEARNER_AI_RPM=15
JAVADSA_SESSION_AI_RPM=10
JAVADSA_GLOBAL_AI_RPM=60

# --- Cache & Session Lifecycle ---
JAVADSA_SESSION_CACHE_MAX_ENTRIES=1000
JAVADSA_SESSION_CACHE_IDLE_TIMEOUT_MINUTES=30
JAVADSA_SESSION_TTL_HOURS=24
JAVADSA_CLEANUP_ENABLED=true
JAVADSA_CLEANUP_REAPER_CRON=0 0 * * * *

# --- AI Provider Integration (Optional) ---
# Google AI Studio Gemini API key for live LLM evaluations.
# LEAVE EMPTY to run in deterministic offline mock evaluator mode (Zero cloud cost / ₹0 budget).
GEMINI_API_KEY=
